+// Project only web-exposed enumeration/change results while keeping raw
+// capture snapshots and operational device IDs untouched for MediaStreamManager.
+void ProjectWebExposedMediaDevices(
+    MediaDeviceType type,
+    bool use_fake_devices,
+    const ungoogled::fingerprint::DisplayProfile& dp,
+    blink::WebMediaDeviceInfoArray* devices) {
+  if (!dp.has_internal || use_fake_devices || !devices) {
+    return;
+  }
+  if (type == MediaDeviceType::kMediaVideoInput && !dp.is_internal) {
+    devices->clear();
+    return;
+  }
+  for (auto& info : *devices) {
+    if (!info.label.empty()) {
+      if (type == MediaDeviceType::kMediaAudioInput) {
+        info.label = "Built-in Microphone";
+      } else if (type == MediaDeviceType::kMediaAudioOutput) {
+        info.label = "Built-in Output";
+      } else if (type == MediaDeviceType::kMediaVideoInput) {
+        info.label = "FaceTime HD Camera";
+      }
+    }
+    if (type == MediaDeviceType::kMediaVideoInput) {
+      info.video_facing = blink::mojom::FacingMode::kUser;
+    }
+  }
+}
