+// Matches kMacOSWebGLConfigs[0..12] chip core counts so unconfigured macOS
+// CLI runs never report non-Apple counts such as 18/22/26/30.
+constexpr std::array<unsigned, 13> kAppleSiliconFallbackCores = {
+    10, 8, 8, 8, 10, 12, 12, 14, 10, 12, 16, 16, 8};
