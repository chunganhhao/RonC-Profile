+++ b/components/ungoogled/fingerprint_display.h
@@ -0,0 +1,162 @@
+// Copyright 2026 The RonC Profile Authors
+// Use of this source code is governed by a BSD-style license in LICENSE.
+#ifndef COMPONENTS_UNGOOGLED_FINGERPRINT_DISPLAY_H_
+#define COMPONENTS_UNGOOGLED_FINGERPRINT_DISPLAY_H_
+
+#include <cmath>
+#include <cstddef>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <type_traits>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "components/ungoogled/ungoogled_switches.h"
+
+namespace ungoogled::fingerprint {
+
+struct DisplayProfile {
+  bool has_screen = false;
+  int width = 0;
+  int height = 0;
+  int avail_left = 0;
+  int avail_top = 0;
+  int avail_width = 0;
+  int avail_height = 0;
+  double dpr = 0.0;
+  int color_depth = 0;    // 24 or 30 when explicitly set
+  int gamut = 0;          // 0=unset, 1=srgb, 2=p3
+  bool has_internal = false;
+  bool is_internal = false;
+  int color_scheme = 0;   // 0=unset, 1=light, 2=dark
+  bool has_display_profile = false;
+};
+
+static_assert(std::is_trivially_destructible_v<DisplayProfile>,
+              "DisplayProfile must stay trivially destructible");
+
+inline DisplayProfile ParseDisplayProfile() {
+  DisplayProfile profile;
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(switches::kDisableSpoofing)) {
+    const std::string disabled = base::ToLowerASCII(
+        command_line->GetSwitchValueASCII(switches::kDisableSpoofing));
+    if (disabled.find("screen") != std::string::npos ||
+        disabled.find("all") != std::string::npos) {
+      return profile;
+    }
+  }
+
+  int width = 0;
+  int height = 0;
+  if (command_line->HasSwitch(switches::kFingerprintScreenWidth) &&
+      command_line->HasSwitch(switches::kFingerprintScreenHeight) &&
+      base::StringToInt(
+          command_line->GetSwitchValueASCII(switches::kFingerprintScreenWidth),
+          &width) &&
+      base::StringToInt(
+          command_line->GetSwitchValueASCII(switches::kFingerprintScreenHeight),
+          &height) &&
+      width >= 320 && width <= 8192 && height >= 240 && height <= 8192) {
+    profile.has_screen = true;
+    profile.width = width;
+    profile.height = height;
+    profile.avail_width = width;
+    profile.avail_height = height;
+  }
+
+  double dpr = 0.0;
+  if (command_line->HasSwitch(switches::kFingerprintDeviceScaleFactor) &&
+      base::StringToDouble(
+          command_line->GetSwitchValueASCII(
+              switches::kFingerprintDeviceScaleFactor),
+          &dpr) &&
+      std::isfinite(dpr) && dpr >= 0.5 && dpr <= 4.0) {
+    profile.dpr = dpr;
+  }
+
+  if (command_line->HasSwitch(switches::kFingerprintDisplayProfile)) {
+    const std::string raw = command_line->GetSwitchValueASCII(
+        switches::kFingerprintDisplayProfile);
+    if (!raw.empty()) {
+      profile.has_display_profile = true;
+    }
+    for (std::string_view token : base::SplitStringPiece(
+             raw, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      const size_t eq = token.find('=');
+      if (eq == std::string_view::npos) {
+        continue;
+      }
+      const std::string key = base::ToLowerASCII(token.substr(0, eq));
+      const std::string val = base::ToLowerASCII(token.substr(eq + 1));
+      int iv = 0;
+      if (key == "avail_left" && base::StringToInt(val, &iv) && iv >= 0) {
+        profile.avail_left = iv;
+      } else if (key == "avail_top" && base::StringToInt(val, &iv) && iv >= 0) {
+        profile.avail_top = iv;
+      } else if (key == "avail_width" && base::StringToInt(val, &iv) &&
+                 iv >= 320) {
+        profile.avail_width = iv;
+      } else if (key == "avail_height" && base::StringToInt(val, &iv) &&
+                 iv >= 240) {
+        profile.avail_height = iv;
+      } else if (key == "color_depth" && base::StringToInt(val, &iv) &&
+                 (iv == 24 || iv == 30)) {
+        profile.color_depth = iv;
+      } else if (key == "gamut") {
+        if (val == "p3") {
+          profile.gamut = 2;
+        } else if (val == "srgb") {
+          profile.gamut = 1;
+        }
+      } else if (key == "internal") {
+        if (val == "1" || val == "true") {
+          profile.has_internal = true;
+          profile.is_internal = true;
+        } else if (val == "0" || val == "false") {
+          profile.has_internal = true;
+          profile.is_internal = false;
+        }
+      } else if (key == "scheme") {
+        if (val == "dark") {
+          profile.color_scheme = 2;
+        } else if (val == "light") {
+          profile.color_scheme = 1;
+        }
+      }
+    }
+  }
+
+  if (profile.has_screen) {
+    if (profile.avail_left >= profile.width) {
+      profile.avail_left = 0;
+    }
+    if (profile.avail_top >= profile.height) {
+      profile.avail_top = 0;
+    }
+    if (profile.avail_width > profile.width - profile.avail_left) {
+      profile.avail_width = profile.width - profile.avail_left;
+    }
+    if (profile.avail_height > profile.height - profile.avail_top) {
+      profile.avail_height = profile.height - profile.avail_top;
+    }
+  }
+  return profile;
+}
+
+inline const DisplayProfile& GetActiveDisplayProfile() {
+  // Use constinit std::once_flag so initialization stays thread-safe even under
+  // Chromium's -fno-threadsafe-statics without exit-time destructors.
+  static constinit std::once_flag kInitFlag;
+  static DisplayProfile kProfile;
+  std::call_once(kInitFlag, [] { kProfile = ParseDisplayProfile(); });
+  return kProfile;
+}
+
+}  // namespace ungoogled::fingerprint
+
+#endif  // COMPONENTS_UNGOOGLED_FINGERPRINT_DISPLAY_H_
