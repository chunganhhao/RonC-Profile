+float HalfToFloat(uint16_t h) {
+  const uint32_t sign = static_cast<uint32_t>(h & 0x8000u) << 16;
+  const uint32_t exp = (h >> 10) & 0x1Fu;
+  const uint32_t mant = h & 0x03FFu;
+  uint32_t out = 0;
+  if (exp == 0u) {
+    if (mant == 0u) {
+      out = sign;
+    } else {
+      uint32_t m = mant;
+      uint32_t e = 127u - 14u;
+      while ((m & 0x0400u) == 0u) {
+        m <<= 1;
+        --e;
+      }
+      m &= 0x03FFu;
+      out = sign | (e << 23) | (m << 13);
+    }
+  } else if (exp == 0x1Fu) {
+    out = sign | 0x7F800000u | (mant ? (mant << 13) | 0x00400000u : 0u);
+  } else {
+    out = sign | ((exp + (127u - 15u)) << 23) | (mant << 13);
+  }
+  return base::bit_cast<float>(out);
+}
+
+uint16_t FloatToHalf(float value) {
+  const uint32_t bits = base::bit_cast<uint32_t>(value);
+  const uint16_t sign = static_cast<uint16_t>((bits >> 16) & 0x8000u);
+  const uint32_t abs_bits = bits & 0x7FFFFFFFu;
+  if (abs_bits > 0x7F800000u) {
+    const uint32_t mant = (abs_bits & 0x007FFFFFu) >> 13;
+    return static_cast<uint16_t>(sign | 0x7E00u | (mant ? mant : 1u));
+  }
+  if (abs_bits >= 0x47800000u) {
+    return static_cast<uint16_t>(sign | 0x7C00u);
+  }
+  if (abs_bits < 0x38800000u) {
+    const uint32_t exp = abs_bits >> 23;
+    if (exp < 102u) {
+      return sign;
+    }
+    const uint32_t shift = 126u - exp;
+    const uint32_t mant = 0x00800000u | (abs_bits & 0x007FFFFFu);
+    uint32_t h_mant = mant >> shift;
+    const uint32_t rem = mant & ((1u << shift) - 1u);
+    const uint32_t half = 1u << (shift - 1u);
+    if (rem > half || (rem == half && (h_mant & 1u) != 0u)) {
+      ++h_mant;
+    }
+    return static_cast<uint16_t>(sign | h_mant);
+  }
+  uint32_t exp = (abs_bits >> 23) - (127u - 15u);
+  uint32_t mant = abs_bits & 0x007FFFFFu;
+  const uint32_t round_bits = mant & 0x00001FFFu;
+  mant >>= 13;
+  if (round_bits > 0x00001000u ||
+      (round_bits == 0x00001000u && (mant & 1u) != 0u)) {
+    ++mant;
+    if (mant == 0x0400u) {
+      mant = 0u;
+      ++exp;
+      if (exp >= 31u) {
+        return static_cast<uint16_t>(sign | 0x7C00u);
+      }
+    }
+  }
+  return static_cast<uint16_t>(sign | (exp << 10) | mant);
+}
+
+uint8_t FingerprintBit(const std::string& seed_str, int x, int y,
+                       const char* suffix) {
+  const std::string key = seed_str + "_x" + std::to_string(x) + "_y" +
+                          std::to_string(y) + suffix;
+  return static_cast<uint8_t>(std::hash<std::string>{}(key) & 1u);
+}
+
+void ShuffleExtendedWebGLPixels(uint8_t* data, int width, int height,
+                                size_t stride, size_t pixel_size, GLenum type,
+                                const std::string& seed_str) {
+  if (!data || width < 2 || height < 2 || seed_str.empty()) {
+    return;
+  }
+  const int64_t area_budget = (static_cast<int64_t>(width) * height) / 128;
+  const int max_pixels =
+      static_cast<int>(std::clamp<int64_t>(area_budget, 2, 10));
+  int modified_pixels = 0;
+  std::unordered_set<int> processed_rows;
+  std::unordered_set<int> processed_cols;
+
+  auto pixel_ptr = [&](int px, int py) -> uint8_t* {
+    return UNSAFE_TODO(data + static_cast<size_t>(py) * stride +
+                       static_cast<size_t>(px) * pixel_size);
+  };
+  auto load_float4 = [&](const uint8_t* ptr) -> std::array<float, 4> {
+    std::array<float, 4> out{};
+    if (type == GL_FLOAT) {
+      UNSAFE_TODO(std::memcpy(out.data(), ptr, 16));
+      return out;
+    }
+    std::array<uint16_t, 4> raw{};
+    UNSAFE_TODO(std::memcpy(raw.data(), ptr, 8));
+    for (size_t i = 0; i < 4; ++i) {
+      out[i] = HalfToFloat(raw[i]);
+    }
+    return out;
+  };
+  auto store_float4 = [&](uint8_t* ptr, const std::array<float, 4>& in) {
+    if (type == GL_FLOAT) {
+      UNSAFE_TODO(std::memcpy(ptr, in.data(), 16));
+      return;
+    }
+    std::array<uint16_t, 4> raw{};
+    for (size_t i = 0; i < 4; ++i) {
+      raw[i] = FloatToHalf(in[i]);
+    }
+    UNSAFE_TODO(std::memcpy(ptr, raw.data(), 8));
+  };
+
+  for (int y = 0; y < height - 1 && modified_pixels < max_pixels; ++y) {
+    if (processed_rows.contains(y)) {
+      continue;
+    }
+    for (int x = 0; x < width - 1 && modified_pixels < max_pixels; ++x) {
+      if (processed_cols.contains(x)) {
+        continue;
+      }
+      uint8_t* cur_ptr = pixel_ptr(x, y);
+      const uint8_t* right_ptr = pixel_ptr(x + 1, y);
+      const uint8_t* bottom_ptr = pixel_ptr(x, y + 1);
+      if (type == GL_UNSIGNED_SHORT_5_5_5_1) {
+        uint16_t cur = 0;
+        uint16_t right = 0;
+        uint16_t bottom = 0;
+        UNSAFE_TODO(std::memcpy(&cur, cur_ptr, 2));
+        UNSAFE_TODO(std::memcpy(&right, right_ptr, 2));
+        UNSAFE_TODO(std::memcpy(&bottom, bottom_ptr, 2));
+        unsigned r = (cur >> 11) & 0x1Fu;
+        unsigned g = (cur >> 6) & 0x1Fu;
+        unsigned b = (cur >> 1) & 0x1Fu;
+        const bool is_valid =
+            !((r == 0u && g == 0u && b == 0u) ||
+              (r == 31u && g == 31u && b == 31u));
+        if (!is_valid || (cur == right && cur == bottom)) {
+          continue;
+        }
+        const unsigned a = cur & 0x1u;
+        r = (r & ~0x1u) | FingerprintBit(seed_str, x, y, "_r");
+        g = (g & ~0x1u) | FingerprintBit(seed_str, x, y, "_g");
+        b = (b & ~0x1u) | FingerprintBit(seed_str, x, y, "_b");
+        const uint16_t packed =
+            static_cast<uint16_t>((r << 11) | (g << 6) | (b << 1) | a);
+        UNSAFE_TODO(std::memcpy(cur_ptr, &packed, 2));
+        ++modified_pixels;
+        processed_rows.insert(y);
+        processed_cols.insert(x);
+        continue;
+      }
+
+      std::array<float, 4> cur = load_float4(cur_ptr);
+      bool in_gamut = true;
+      for (size_t i = 0; i < 4; ++i) {
+        if (!std::isfinite(cur[i]) || cur[i] < 0.0f || cur[i] > 1.0f) {
+          in_gamut = false;
+          break;
+        }
+      }
+      if (!in_gamut) {
+        continue;
+      }
+      std::array<uint8_t, 3> q{};
+      for (size_t i = 0; i < 3; ++i) {
+        q[i] = static_cast<uint8_t>(std::lround(cur[i] * 255.0f));
+      }
+      if ((q[0] == 0u && q[1] == 0u && q[2] == 0u) ||
+          (q[0] == 255u && q[1] == 255u && q[2] == 255u)) {
+        continue;
+      }
+      const std::array<float, 4> right = load_float4(right_ptr);
+      const std::array<float, 4> bottom = load_float4(bottom_ptr);
+      bool is_edge = false;
+      for (size_t i = 0; i < 4; ++i) {
+        if (!(cur[i] == right[i]) || !(cur[i] == bottom[i])) {
+          is_edge = true;
+          break;
+        }
+      }
+      if (!is_edge) {
+        continue;
+      }
+      const std::array<uint8_t, 3> bits = {
+          FingerprintBit(seed_str, x, y, "_r"),
+          FingerprintBit(seed_str, x, y, "_g"),
+          FingerprintBit(seed_str, x, y, "_b"),
+      };
+      for (size_t i = 0; i < 3; ++i) {
+        const uint8_t perturbed = (q[i] & ~uint8_t{1}) | bits[i];
+        if (perturbed != q[i]) {
+          cur[i] = static_cast<float>(perturbed) / 255.0f;
+        }
+      }
+      store_float4(cur_ptr, cur);
+      ++modified_pixels;
+      processed_rows.insert(y);
+      processed_cols.insert(x);
+    }
+  }
+}
