+bool WebGLRenderingContextBase::ReadFingerprintPixels(
+    WebGLFramebuffer* framebuffer, GLint x, GLint y, GLsizei width,
+    GLsizei height, GLenum format, GLenum type, uint8_t* data,
+    size_t destination_size, GLuint pack_buffer, int64_t pack_offset) {
+  constexpr GLenum kInternalTextureWidth = 0x1000;
+  constexpr GLenum kInternalTextureHeight = 0x1001;
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  if (!command->HasSwitch(switches::kFingerprint) ||
+      command->GetSwitchValueASCII(switches::kDisableSpoofing).find("canvas") !=
+          std::string::npos ||
+      width <= 0 || height <= 0) {
+    return false;
+  }
+  SkColorType color_type;
+  if (format == GL_RGBA && type == GL_UNSIGNED_BYTE) {
+    color_type = kRGBA_8888_SkColorType;
+  } else if (format == GL_RGB && type == GL_UNSIGNED_SHORT_5_6_5) {
+    color_type = kRGB_565_SkColorType;
+  } else if (format == GL_RGBA && type == GL_UNSIGNED_SHORT_4_4_4_4) {
+    color_type = kARGB_4444_SkColorType;
+  } else {
+    return false;  // Existing native noise contract excludes FLOAT/integer/HDR.
+  }
+  const GLenum target = IsWebGL2() ? GL_READ_FRAMEBUFFER : GL_FRAMEBUFFER;
+  if (ContextGL()->CheckFramebufferStatus(target) != GL_FRAMEBUFFER_COMPLETE ||
+      (framebuffer && framebuffer->GetReadBuffer() == GL_NONE)) {
+    return false;
+  }
+  if (!framebuffer && IsWebGL2()) {
+    GLint read_buffer = GL_BACK;
+    ContextGL()->GetIntegerv(GL_READ_BUFFER, &read_buffer);
+    if (read_buffer == GL_NONE) {
+      return false;
+    }
+  }
+  GLint implementation_format = 0;
+  GLint implementation_type = 0;
+  ContextGL()->GetIntegerv(GL_IMPLEMENTATION_COLOR_READ_FORMAT,
+                           &implementation_format);
+  ContextGL()->GetIntegerv(GL_IMPLEMENTATION_COLOR_READ_TYPE,
+                           &implementation_type);
+  const bool is_unorm_implementation_type =
+      implementation_type == GL_UNSIGNED_BYTE ||
+      implementation_type == GL_UNSIGNED_SHORT_5_6_5 ||
+      implementation_type == GL_UNSIGNED_SHORT_4_4_4_4 ||
+      implementation_type == GL_UNSIGNED_SHORT_5_5_5_1;
+  const bool matches_impl =
+      format == static_cast<GLenum>(implementation_format) &&
+      type == static_cast<GLenum>(implementation_type);
+  if (!matches_impl &&
+      !(format == GL_RGBA && type == GL_UNSIGNED_BYTE &&
+        is_unorm_implementation_type)) {
+    return false;  // Preserve the driver's validation for illegal read pairs.
+  }
+  GLint source_width = drawingBufferWidth();
+  GLint source_height = drawingBufferHeight();
+  if (framebuffer) {
+    ContextGL()->GetFramebufferAttachmentParameteriv(
+        target, framebuffer->GetReadBuffer(), kInternalTextureWidth,
+        &source_width);
+    ContextGL()->GetFramebufferAttachmentParameteriv(
+        target, framebuffer->GetReadBuffer(), kInternalTextureHeight,
+        &source_height);
+  }
+  if (source_width <= 0 || source_height <= 0) {
+    GLint attachment_type = GL_NONE;
+    if (framebuffer) {
+      ContextGL()->GetFramebufferAttachmentParameteriv(
+          target, framebuffer->GetReadBuffer(),
+          GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &attachment_type);
+    }
+    if (!framebuffer || attachment_type == GL_NONE) {
+      return false;  // Unattached readBuffer -> let driver emit INVALID_OPERATION.
+    }
+    SynthesizeGLError(GL_INVALID_OPERATION, "readPixels",
+                      "Native readback extent unavailable");
+    return true;
+  }
+  const SkAlphaType alpha_type = color_type == kRGB_565_SkColorType
+                                     ? kOpaque_SkAlphaType
+                                     : kUnpremul_SkAlphaType;
+  const SkImageInfo info =
+      SkImageInfo::Make(source_width, source_height, color_type, alpha_type);
+  const size_t source_stride = info.minRowBytes();
+  const size_t source_size = info.computeMinByteSize();
+  constexpr size_t kMaxReadbackBytes = 256u * 1024u * 1024u;
+  if (info.isEmpty() || SkImageInfo::ByteSizeOverflowed(source_size) ||
+      source_size > kMaxReadbackBytes) {
+    SynthesizeGLError(GL_OUT_OF_MEMORY, "readPixels",
+                      "Native readback budget exceeded");
+    return true;  // Fail closed; never fall back to an unprotected read.
+  }
+  const auto pack = GetPackPixelStoreParams();
+  unsigned bytes = 0;
+  unsigned padding = 0;
+  unsigned skip = 0;
+  if (WebGLImageConversion::ComputeImageSizeInBytes(
+          format, type, width, height, 1, pack, &bytes, &padding, &skip) !=
+          GL_NO_ERROR ||
+      static_cast<uint64_t>(bytes) + skip > destination_size) {
+    SynthesizeGLError(GL_INVALID_OPERATION, "readPixels",
+                      "Invalid native pack layout");
+    return true;
+  }
+  const size_t pixel_size = info.bytesPerPixel();
+  const size_t row_bytes = static_cast<size_t>(width) * pixel_size;
+  const size_t stride =
+      static_cast<size_t>(pack.row_length ? pack.row_length : width) *
+          pixel_size +
+      padding;
+  if (row_bytes > kMaxReadbackBytes) {
+    SynthesizeGLError(GL_OUT_OF_MEMORY, "readPixels",
+                      "Native row budget exceeded");
+    return true;
+  }
+  Vector<uint8_t> source(static_cast<wtf_size_t>(source_size));
+  if (pack_buffer) {
+    ContextGL()->BindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+  }
+  ContextGL()->PixelStorei(GL_PACK_ALIGNMENT, 1);
+  if (IsWebGL2()) {
+    ContextGL()->PixelStorei(GL_PACK_ROW_LENGTH, 0);
+    ContextGL()->PixelStorei(GL_PACK_SKIP_PIXELS, 0);
+    ContextGL()->PixelStorei(GL_PACK_SKIP_ROWS, 0);
+  }
+  ContextGL()->ReadPixels(0, 0, source_width, source_height, format, type,
+                          source.data());
+  DrawingBufferClientRestorePixelPackParameters();
+  DrawingBufferClientRestorePixelPackBufferBinding();
+  // Both canvas exports and native noise use top-down source coordinates.
+  for (int row = 0; row < source_height / 2; ++row) {
+    uint8_t* top = UNSAFE_TODO(
+        source.data() + static_cast<size_t>(row) * source_stride);
+    uint8_t* bottom = UNSAFE_TODO(
+        source.data() +
+        static_cast<size_t>(source_height - 1 - row) * source_stride);
+    UNSAFE_TODO(std::swap_ranges(top, top + source_stride, bottom));
+  }
+  StaticBitmapImage::ShuffleSubchannelColorData(source.data(), info, 0, 0);
+  const int64_t left = std::max<int64_t>(0, -static_cast<int64_t>(x));
+  const int64_t right =
+      std::min<int64_t>(width, static_cast<int64_t>(source_width) - x);
+  Vector<uint8_t> pbo_row(
+      static_cast<wtf_size_t>(pack_buffer ? row_bytes : 0));
+  for (int row = 0; row < height; ++row) {
+    const uint64_t destination =
+        static_cast<uint64_t>(skip) + static_cast<uint64_t>(row) * stride;
+    if (destination > destination_size ||
+        row_bytes > destination_size - destination) {
+      SynthesizeGLError(GL_INVALID_OPERATION, "readPixels",
+                        "Native row exceeds destination");
+      return true;
+    }
+    uint8_t* output =
+        pack_buffer ? pbo_row.data() : UNSAFE_TODO(data + destination);
+    UNSAFE_TODO(std::memset(output, 0, row_bytes));
+    const int64_t sy = static_cast<int64_t>(y) + row;
+    if (sy >= 0 && sy < source_height && left < right) {
+      const size_t position =
+          static_cast<size_t>(source_height - 1 - sy) * source_stride +
+          static_cast<size_t>(static_cast<int64_t>(x) + left) * pixel_size;
+      UNSAFE_TODO(std::memcpy(
+          output + static_cast<size_t>(left) * pixel_size,
+          source.data() + position,
+          static_cast<size_t>(right - left) * pixel_size));
+    }
+    if (pack_buffer) {
+      ContextGL()->BufferSubData(
+          GL_PIXEL_PACK_BUFFER,
+          static_cast<GLintptr>(static_cast<uint64_t>(pack_offset) +
+                                destination),
+          static_cast<GLsizeiptr>(row_bytes), output);
+    }
+  }
+  return true;
+}
