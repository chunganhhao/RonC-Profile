+struct FingerprintFontDecision {
+  bool hide = false;
+  std::string substitute_family;
+};
+
+static const char* CurrentFingerprintOs() {
+#if BUILDFLAG(IS_WIN)
+  return "windows";
+#elif BUILDFLAG(IS_MAC)
+  return "macos";
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  return "linux";
+#else
+  return "linux";
+#endif
+}
+
+static FingerprintFontDecision EvaluateFingerprintFont(
+    const std::string& requested_family) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kFingerprint) ||
+      (command_line->HasSwitch(switches::kDisableSpoofing) &&
+       command_line->GetSwitchValueASCII(switches::kDisableSpoofing)
+               .find("font") != std::string::npos) ||
+      IsBasicFont(requested_family)) {
+    return {};
+  }
+
+  const char* current_os = CurrentFingerprintOs();
+  std::string spoofed_platform = base::ToLowerASCII(
+      command_line->GetSwitchValueASCII(switches::kFingerprintPlatform));
+  if (spoofed_platform.empty()) {
+    spoofed_platform = current_os;
+  }
+
+  const std::string canonical_family = base::ToLowerASCII(requested_family);
+  const std::string fingerprint =
+      command_line->GetSwitchValueASCII(switches::kFingerprint);
+  const uint32_t hash = static_cast<uint32_t>(
+      std::hash<std::string>{}(fingerprint + canonical_family));
+  const float probability =
+      static_cast<float>(hash) /
+      static_cast<float>(std::numeric_limits<uint32_t>::max());
+
+  if (spoofed_platform != current_os) {
+    const std::vector<std::string> platform_fonts =
+        GetPlatformFonts(spoofed_platform);
+    const bool is_platform_font = std::any_of(
+        platform_fonts.begin(), platform_fonts.end(),
+        [&](const std::string& pf) {
+          return base::EqualsCaseInsensitiveASCII(pf, canonical_family);
+        });
+    if (is_platform_font) {
+      const std::vector<std::string> current_os_fonts =
+          GetPlatformFonts(current_os);
+      if (!current_os_fonts.empty()) {
+        return {false, current_os_fonts[hash % current_os_fonts.size()]};
+      }
+      return {};
+    }
+    return {probability < 0.95, {}};
+  }
+  return {probability < 0.02, {}};
+}
+
+// static
+bool FontCache::IsFontFamilyHiddenByFingerprint(const String& family) {
+  return EvaluateFingerprintFont(family.Utf8()).hide;
+}
 
