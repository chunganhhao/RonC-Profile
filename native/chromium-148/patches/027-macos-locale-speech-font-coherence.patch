+// static
+void LocaleController::Init() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kFingerprint)) {
+    return;
+  }
+  if (command_line->HasSwitch(switches::kDisableSpoofing) &&
+      command_line->GetSwitchValueASCII(switches::kDisableSpoofing)
+              .find("locale") != std::string::npos) {
+    return;
+  }
+  const std::string requested = command_line->GetSwitchValueASCII("lang");
+  if (requested.empty()) {
+    return;
+  }
+  String locale_str = String::FromUtf8(requested);
+  icu::Locale locale_object(locale_str.Ascii().data());
+  const char* lang = locale_object.getLanguage();
+  if (!lang || *lang == '\0') {
+    return;
+  }
+  instance().SetEmbedderLocale(locale_str);
+}
+
+void LocaleController::SetEmbedderLocale(const String& locale) {
+  base::AutoLock locker(lock_);
+  embedder_locale_ = locale;
+  if (locale_override_.empty()) {
+    UpdateLocale(locale);
+  }
+}
