+uint64_t AudioFingerprintSeedHash() {
+  static const uint64_t kSeedHash = []() -> uint64_t {
+    const base::CommandLine* command_line =
+        base::CommandLine::ForCurrentProcess();
+    if (!command_line->HasSwitch(switches::kFingerprint)) {
+      return 0u;
+    }
+    const std::string disabled =
+        command_line->GetSwitchValueASCII(switches::kDisableSpoofing);
+    if (disabled.find("audio") != std::string::npos) {
+      return 0u;
+    }
+    const std::string fp =
+        command_line->GetSwitchValueASCII(switches::kFingerprint);
+    if (fp.empty()) {
+      return 0u;
+    }
+    uint64_t h = 14695981039346656037ULL;
+    for (unsigned char c : fp) {
+      h ^= c;
+      h *= 1099511628211ULL;
+    }
+    return h ? h : 1u;
+  }();
+  return kSeedHash;
+}
+
+float PerturbAudioSample(float sample, uint64_t salt, uint64_t frame_index) {
+  if (sample == 0.0f || !std::isfinite(sample) || std::fabs(sample) >= 16.0f) {
+    return sample;
+  }
+  uint64_t x = salt ^ frame_index;
+  x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
+  x ^= (x >> 31);
+  // 2^-20 (~-120 dBFS): above float32 ULP rounding up to |sample| < 16.
+  constexpr float kStep = 9.5367431640625e-7f;
+  const float sign = (x & 1u) ? 1.0f : -1.0f;
+  const float magnitude = static_cast<float>((x >> 1) & 3u) + 1.0f;
+  return sample + sign * magnitude * kStep;
+}
+
