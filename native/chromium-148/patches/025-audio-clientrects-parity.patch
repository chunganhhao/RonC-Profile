+void OffsetNonEmptyClientRect(gfx::RectF& rect, double raw_dx, double raw_dy) {
+  if (rect.IsEmpty()) {
+    return;
+  }
+  float dx = static_cast<float>(raw_dx);
+  float dy = static_cast<float>(raw_dy);
+  if (rect.x() == 0.0f && dx < 0.0f) {
+    dx = -dx;
+  }
+  if (rect.y() == 0.0f && dy < 0.0f) {
+    dy = -dy;
+  }
+  rect.Offset(dx, dy);
+}
